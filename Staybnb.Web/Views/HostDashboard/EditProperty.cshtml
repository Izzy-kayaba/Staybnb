@* Limits listing edits to the explicit fields accepted by EditPropertyViewModel. *@
@model EditPropertyViewModel
@{ ViewData["Title"] = "Edit property"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-8"><a asp-action="Index" class="back-link">← Host dashboard</a><form method="post" class="panel mt-3"><input asp-for="Id" type="hidden" /><span class="eyebrow">Listing details</span><h1 class="h2 fw-bold">Edit property</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
    <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="col-md-4"><label asp-for="PricePerNight" class="form-label"></label><input asp-for="PricePerNight" class="form-control" /></div><div class="col-md-4"><label asp-for="CleaningFee" class="form-label"></label><input asp-for="CleaningFee" class="form-control" /></div><div class="col-md-4"><label asp-for="ServiceFee" class="form-label"></label><input asp-for="ServiceFee" class="form-control" /></div>
    <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div><div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div><div class="col-md-6"><label asp-for="PropertyType" class="form-label"></label><select asp-for="PropertyType" class="form-select"><option>Apartment</option><option>House</option><option>Cottage</option><option>Studio</option><option>Villa</option></select></div>
    </div><button class="btn btn-primary mt-4" type="submit">Save changes</button></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
