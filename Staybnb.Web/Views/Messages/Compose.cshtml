@* Sends a database-backed message to an existing Staybnb account. *@
@model ComposeMessageViewModel
@{ ViewData["Title"] = "Compose message"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Inbox</a><form method="post" class="panel mt-3" data-loading-form data-loading-text="Sending message..."><input asp-for="ReplyToMessageId" type="hidden" /><span class="eyebrow">New message</span><h1 class="h2 fw-bold">Write a message</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="RecipientEmail" class="form-label"></label><input asp-for="RecipientEmail" class="form-control" /><span asp-validation-for="RecipientEmail" class="text-danger"></span></div><div class="mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="mb-3"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control"></textarea><span asp-validation-for="Body" class="text-danger"></span></div><button class="btn btn-primary" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Send message</button></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
