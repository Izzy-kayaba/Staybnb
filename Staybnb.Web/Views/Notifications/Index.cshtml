@* Shows account-scoped status updates and explicit read-state controls. *@
@model IReadOnlyList<Notification>
@{ ViewData["Title"] = "Notifications"; }
<div class="container"><div class="dashboard-header"><div><span class="eyebrow">Status centre</span><h1>Notifications</h1><p class="text-muted mb-0">Booking, message, role and application updates.</p></div><form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-dark"><i class="bi bi-check2-all" aria-hidden="true"></i> Mark all read</button></form></div>
<div class="row g-3">@foreach (var notification in Model) { <div class="col-12"><article class="panel notification @(!notification.IsRead ? "unread" : "") mb-0"><div class="d-md-flex justify-content-between align-items-center gap-3"><div><div class="d-flex gap-2 align-items-center"><strong>@notification.Title</strong>@if (!notification.IsRead) { <span class="status status--unread">Unread</span> }</div><p class="mb-1">@notification.Body</p><small class="text-muted">@notification.Type · @notification.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small></div>@if (!notification.IsRead) { <form asp-action="Read" asp-route-id="@notification.Id" method="post" class="mt-3 mt-md-0"><button class="btn btn-sm btn-primary" aria-label="Mark @notification.Title as read">Mark read</button></form> }</div></article></div> }</div>
@if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-bell-slash empty-state-icon" aria-hidden="true"></i><strong>No notifications</strong><span>Booking, message and account updates will appear here.</span></div> }
</div>
