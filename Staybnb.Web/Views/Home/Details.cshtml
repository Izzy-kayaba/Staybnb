@* Shows public listing details and only offers booking to an authenticated Guest. *@
@model HostProperty
@{
    ViewData["Title"] = Model.Title;
    var images = Model.Images.ToList();
    var galleryClass = images.Count >= 3 ? "property-gallery property-gallery--many" : "property-gallery";
}
<div class="container py-5">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to listings</a>
    <div class="detail-grid mt-3">
        <div class="@galleryClass">
            @if (images.Count == 0)
            {
                <img class="detail-image" src="/images/properties/modern-apartment.png" alt="@Model.Title" />
            }
            else
            {
                @for (var index = 0; index < images.Count; index++)
                {
                    <img class="detail-image" src="@images[index].ImageUrl" alt="@Model.Title photo @(index + 1)" />
                }
            }
        </div>
        <div>
            <span class="pill">@Model.PropertyType</span>
            <h1 class="mt-3">@Model.Title</h1>
            <p class="text-muted">@Model.Address, @Model.City <span aria-hidden="true">·</span> Hosted by @(Model.Host?.DisplayName ?? "Staybnb")</p>
            <p>@Model.Description</p>
            <div class="price-box">
                <div><span>Nightly rate</span><strong>@($"R{Model.PricePerNight:N2}")</strong></div>
                <div><span>Cleaning fee</span><strong>@($"R{Model.CleaningFee:N2}")</strong></div>
                <div><span>Service fee</span><strong>@($"R{Model.ServiceFee:N2}")</strong></div>
            </div>
            @if (User.IsInRole("Guest"))
            {
                <a class="btn btn-primary btn-lg w-100 mt-4" asp-controller="GuestDashboard" asp-action="Book" asp-route-id="@Model.Id"><i class="bi bi-calendar-check" aria-hidden="true"></i> Request to book</a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100 mt-4" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in as a Guest to book</a>
            }
        </div>
    </div>
</div>
