@* Provides role-aware navigation and one place for workflow success or error messages. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white" aria-label="Primary navigation">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span aria-hidden="true"><i class="bi bi-house-heart-fill"></i></span> staybnb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Open navigation menu"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : "")" aria-current="@(currentController == "Home" ? "page" : null)" asp-controller="Home" asp-action="Index"><i class="bi bi-compass" aria-hidden="true"></i> Explore</a></li>
                        @if (User.IsInRole("Guest"))
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "GuestDashboard" ? "active" : "")" aria-current="@(currentController == "GuestDashboard" ? "page" : null)" asp-controller="GuestDashboard" asp-action="Index"><i class="bi bi-suitcase-lg" aria-hidden="true"></i> My trips</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "HostApplications" ? "active" : "")" aria-current="@(currentController == "HostApplications" ? "page" : null)" asp-controller="HostApplications" asp-action="Apply"><i class="bi bi-house-add" aria-hidden="true"></i> Become a host</a></li>
                        }
                        @if (User.IsInRole("Host"))
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "HostDashboard" ? "active" : "")" aria-current="@(currentController == "HostDashboard" ? "page" : null)" asp-controller="HostDashboard" asp-action="Index"><i class="bi bi-speedometer2" aria-hidden="true"></i> Host dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "HostApplications" ? "active" : "")" aria-current="@(currentController == "HostApplications" ? "page" : null)" asp-controller="HostApplications" asp-action="Apply"><i class="bi bi-house-add" aria-hidden="true"></i> Add property</a></li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Admin" ? "active" : "")" aria-current="@(currentController == "Admin" ? "page" : null)" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock" aria-hidden="true"></i> Admin dashboard</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Messages" ? "active" : "")" aria-current="@(currentController == "Messages" ? "page" : null)" asp-controller="Messages" asp-action="Index"><i class="bi bi-chat-dots" aria-hidden="true"></i> Messages</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Notifications" ? "active" : "")" aria-current="@(currentController == "Notifications" ? "page" : null)" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell" aria-hidden="true"></i> Notifications</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
        <div class="container pt-4"><partial name="_AlertMessages" /></div>
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container">Staybnb student project · Programming 742 · 2026</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
