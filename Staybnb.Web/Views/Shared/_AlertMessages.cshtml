@* One shared place for workflow feedback keeps alerts consistent and accessible. *@
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success d-flex align-items-start gap-2" role="status" aria-live="polite">
        <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i>
        <span>@success</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
        <span>@error</span>
    </div>
}
